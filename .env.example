# IP fixo do ar-condicionado na sua rede (obrigatório). Rode `npm run discover` para descobrir.
GREE_HOST=192.168.1.50

# Porta HTTP do painel (padrão 3000)
PORT=3000

# Endereço onde o painel escuta. 127.0.0.1 = só este computador. 0.0.0.0 = toda a rede local.
BIND=127.0.0.1

# Intervalo de leitura do status em ms (padrão 3000)
POLL_INTERVAL=3000
